diff --git a/tests/test_physical_systems/test_cont1qc_discontinuous_conduction.py b/tests/test_physical_systems/test_cont1qc_discontinuous_conduction.py
new file mode 100644
index 00000000..c7bd4b9c
--- /dev/null
+++ b/tests/test_physical_systems/test_cont1qc_discontinuous_conduction.py
@@ -0,0 +1,66 @@
+"""Cont1QC in discontinuous conduction: the armature current never becomes negative.
+
+A one-quadrant (buck) converter cannot carry a negative current. When the induced voltage exceeds the
+commanded average voltage, the current falls to zero and stays there, and the machine coasts.
+"""
+
+import numpy as np
+import pytest
+
+import gym_electric_motor as gem
+from gym_electric_motor.physical_systems.converters import ContOneQuadrantConverter, ContTwoQuadrantConverter
+from gym_electric_motor.physical_systems.mechanical_loads import PolynomialStaticLoad
+
+TAU = 1e-4
+
+
+def _env(converter, omega0=150.0, a=0.0, b=0.0, motor="PermExDc"):
+    load = PolynomialStaticLoad(load_parameter=dict(a=a, b=b, c=0.0, j_load=1e-3),
+                                load_initializer={"states": {"omega": omega0}})
+    env = gem.make(f"Cont-SC-{motor}-v0", converter=converter, load=load, visualization=(), constraints=(), tau=TAU)
+    env.reset(seed=0)
+    return env
+
+
+def _run(env, duty, steps):
+    ps = env.unwrapped.physical_system
+    w, i = ps.state_names.index("omega"), ps.state_names.index("i")
+    omegas, currents = [], []
+    for _ in range(steps):
+        (state, _), *_ = env.step(np.array([duty]))
+        omegas.append(state[w] * ps.limits[w])
+        currents.append(state[i] * ps.limits[i])
+    return np.array(omegas), np.array(currents)
+
+
+def test_an_unloaded_motor_coasts_at_duty_zero():
+    """The reproduction of the issue: before the fix i reached -145 A and omega rose 150 -> 182 rad/s."""
+    omegas, currents = _run(_env(ContOneQuadrantConverter()), 0.0, 5000)
+    assert currents.min() >= 0.0
+    assert np.allclose(omegas, 150.0, atol=1e-9)
+
+
+def test_continuous_conduction_is_unchanged():
+    """While the current stays positive, Cont1QC applies the duty cycle exactly like Cont2QC."""
+    duty = 0.9  # 54 V against an induced voltage of 0.165 * 150 = 24.8 V: the current only rises
+    o1, i1 = _run(_env(ContOneQuadrantConverter(), omega0=150.0, a=0.01, b=0.05), duty, 200)
+    o2, i2 = _run(_env(ContTwoQuadrantConverter(), omega0=150.0, a=0.01, b=0.05), duty, 200)
+    assert i2.min() > 0.0
+    np.testing.assert_allclose(i1, i2, rtol=0, atol=1e-9)
+    np.testing.assert_allclose(o1, o2, rtol=0, atol=1e-9)
+
+
+def test_braking_with_friction_only_slows_the_motor():
+    """A duty below the induced voltage: the current decays to zero and the motor slows by friction only,
+    never above its initial speed (no energy is injected)."""
+    omegas, currents = _run(_env(ContOneQuadrantConverter(), omega0=150.0, a=0.01, b=0.05), 0.2, 3000)
+    assert currents.min() >= 0.0
+    assert currents[-1] == 0.0
+    assert omegas.max() <= 150.0 + 1e-9
+    assert np.all(np.diff(omegas) <= 1e-12)
+    assert omegas[-1] < omegas[0]
+
+
+def test_a_motor_with_two_currents_warns_that_the_clamp_is_not_applied():
+    with pytest.warns(UserWarning, match="zero-current clamp"):
+        gem.make("Cont-SC-ShuntDc-v0", converter=ContOneQuadrantConverter(), visualization=(), constraints=())
